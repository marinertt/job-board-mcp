{
  "mcpServers": {
    "job-board-monitor": {
      "command": "/absolute/path/to/.venv/bin/python",
      "args": ["-m", "job_board_mcp.server"],
      "env": {
        "JOB_MONITOR_DB": "/absolute/private/path/jobs.sqlite3",
        "JOB_MONITOR_PROFILE": "/absolute/path/to/profile.json",
        "JOB_MONITOR_SOURCES": "/absolute/path/to/sources.json"
      }
    }
  }
}
